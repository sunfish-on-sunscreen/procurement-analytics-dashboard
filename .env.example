DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/procurement_analytics?schema=public"
SESSION_SECRET="GENERATE_A_32_CHAR_RANDOM_HEX_STRING"
NODE_ENV="development"

# OPTIONAL — enables LLM-generated report narrative for supplier briefs.
# Server-side only (never exposed to the browser). Leave empty and the app is fully
# functional: supplier briefs render with the fixed template narrative.
ANTHROPIC_API_KEY=""
# OPTIONAL — override the narrative model (default: claude-sonnet-5).
ANTHROPIC_REPORT_MODEL=""
