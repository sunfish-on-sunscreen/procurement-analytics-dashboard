DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/procurement_analytics?schema=public"
SESSION_SECRET="GENERATE_A_32_CHAR_RANDOM_HEX_STRING"
NODE_ENV="development"

# OPTIONAL — enables LLM-generated report narrative for supplier briefs (Google Gemini).
# Server-side only (never exposed to the browser — do NOT prefix with NEXT_PUBLIC_).
# Leave empty and the app is fully functional: supplier briefs render with the fixed
# template narrative.
# ⚠️ FREE-TIER DATA HANDLING: on Google's unpaid tier, API inputs and outputs may be used
# to improve Google products and may be read by human reviewers (the paid tier does not).
# The payload is aggregate values only — no transaction rows. See Methodology §2.8.
GEMINI_API_KEY=""
# OPTIONAL — override the narrative model (default: gemini-flash-latest, an alias that
# tracks the current GA flash model). Pin a specific model here if you need reproducibility.
GEMINI_REPORT_MODEL=""
